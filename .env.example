# Mailu + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# NOTE: this single file plays two roles. Docker Compose interpolates the
# UPPER-CASE variables below into the compose file (hostnames, image-tag
# overrides), and every Mailu container also loads this file via
# `env_file:` — so the Mailu application config (SECRET_KEY, DOMAIN,
# HOSTNAMES, ...) lives here too. The stack will not start without it.
#
# Image versions are NOT set here. The tested tag + sha256 digest for all
# fourteen images lives in the compose file's `x-images` block, so
# `git pull` delivers the combination this repository has tested. To pin
# differently, uncomment the matching *_IMAGE_TAG variable, e.g.:
# FRONT_IMAGE_TAG=ghcr.io/mailu/nginx:2024.06.58@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.mailu.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Hostnames routed by Traefik (each needs a DNS record). REQUIRED.
# ──────────────────────────────────────────────────────────────────────────────

MAILU_HOSTNAME=mail.example.com
MAILU_ADMIN_HOSTNAME=admin.mailu.example.com
MAILU_WEBDAV_HOSTNAME=dav.mailu.example.com

# ──────────────────────────────────────────────────────────────────────────────
# Mailu core configuration (read by the containers via env_file)
# Full reference: https://mailu.io/2024.06/configuration.html
# ──────────────────────────────────────────────────────────────────────────────

# Cryptographic secret. REQUIRED — generate with:
#     openssl rand -hex 16
SECRET_KEY=change_me_before_first_start

# Primary mail domain (the part after @ in user addresses). REQUIRED.
DOMAIN=example.com

# Space-separated list of hostnames this server answers as; the first one
# is the canonical name and should match MAILU_HOSTNAME. REQUIRED.
HOSTNAMES=mail.example.com

# Postmaster local part (postmaster@DOMAIN receives abuse/postmaster mail).
POSTMASTER=admin

# TLS for the MAIL ports (SMTPS 465, IMAPS 993, POP3S 995). Traefik only
# terminates TLS for the WEB hostnames; the mail ports are passed through
# as raw TCP, so the `front` container needs its own certificates:
#   mail  — serve TLS from certs in the mailu-certificates volume
#           (export them from Traefik with a certs-dumper, or mount your
#           own cert.pem/key.pem there)
#   notls — plaintext mail ports; acceptable only for testing
TLS_FLAVOR=mail

# Initial admin account, created on first start (mode `update` keeps the
# password in sync with this file; use `ifmissing` to manage it in the UI
# after the first boot).
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=example.com
# REQUIRED — generate with: openssl rand -base64 24 | tr -d '/+=' | head -c 32
INITIAL_ADMIN_PW=change_me_before_first_start
INITIAL_ADMIN_MODE=update

# Web paths served under MAILU_HOSTNAME.
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEBROOT_REDIRECT=/webmail

# Feature toggles matching the services in the compose file.
ADMIN=true
WEBMAIL=roundcube
WEBDAV=radicale
ANTIVIRUS=clamav
SCAN_MACROS=true
FETCHMAIL_ENABLED=true

# Message size limit in bytes (default 50 MB).
MESSAGE_SIZE_LIMIT=50000000

# Internal addressing — must match the compose network settings below.
SUBNET=192.168.203.0/24
REDIS_ADDRESS=redis

# ──────────────────────────────────────────────────────────────────────────────
# Compose-side network settings (defaults in the compose file; keep the
# resolver inside SUBNET if you override)
# ──────────────────────────────────────────────────────────────────────────────

# RESOLVER_IP=192.168.203.254

# ──────────────────────────────────────────────────────────────────────────────
# More options (defaults shown; uncomment to change)
# ──────────────────────────────────────────────────────────────────────────────

# SITENAME=Mailu
# WEBSITE=https://mail.example.com
# TZ=UTC
# LOG_LEVEL=INFO
# API=false
# WEB_API=/api
# API_TOKEN=
# MESSAGE_RATELIMIT=200/day
# AUTH_RATELIMIT_IP=5/hour
# AUTH_RATELIMIT_USER=50/day
# PASSWORD_SCHEME=SHA512-CRYPT
# CREDENTIAL_ROUNDS=12
# RECIPIENT_DELIMITER=+
# DKIM_SELECTOR=mail
# DKIM_KEY_LENGTH=2048
# DMARC_RUA=admin
# DMARC_RUF=admin
# FETCHMAIL_DELAY=600
# FULL_TEXT_SEARCH_ATTACHMENTS=true
# DEFAULT_SPAM_THRESHOLD=80
# WELCOME=false
# RELAYHOST=
# RELAYNETS=
# DISABLE_STATISTICS=True

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# MAILU_REDIS_MEMORY_LIMIT=256m
# MAILU_REDIS_CPU_LIMIT=0.5
# MAILU_REDIS_MEMORY_RESERVATION=32m
# MAILU_REDIS_CPU_RESERVATION=0.1
# MAILU_RESOLVER_MEMORY_LIMIT=512m
# MAILU_RESOLVER_CPU_LIMIT=1.0
# MAILU_RESOLVER_MEMORY_RESERVATION=64m
# MAILU_RESOLVER_CPU_RESERVATION=0.25
# MAILU_FRONT_MEMORY_LIMIT=512m
# MAILU_FRONT_CPU_LIMIT=1.0
# MAILU_FRONT_MEMORY_RESERVATION=64m
# MAILU_FRONT_CPU_RESERVATION=0.25
# MAILU_ADMIN_MEMORY_LIMIT=512m
# MAILU_ADMIN_CPU_LIMIT=1.0
# MAILU_ADMIN_MEMORY_RESERVATION=64m
# MAILU_ADMIN_CPU_RESERVATION=0.25
# MAILU_IMAP_MEMORY_LIMIT=512m
# MAILU_IMAP_CPU_LIMIT=1.0
# MAILU_IMAP_MEMORY_RESERVATION=64m
# MAILU_IMAP_CPU_RESERVATION=0.25
# MAILU_SMTP_MEMORY_LIMIT=512m
# MAILU_SMTP_CPU_LIMIT=1.0
# MAILU_SMTP_MEMORY_RESERVATION=64m
# MAILU_SMTP_CPU_RESERVATION=0.25
# MAILU_OLETOOLS_MEMORY_LIMIT=512m
# MAILU_OLETOOLS_CPU_LIMIT=1.0
# MAILU_OLETOOLS_MEMORY_RESERVATION=64m
# MAILU_OLETOOLS_CPU_RESERVATION=0.25
# MAILU_FTS_ATTACHMENTS_MEMORY_LIMIT=1g
# MAILU_FTS_ATTACHMENTS_CPU_LIMIT=1.0
# MAILU_FTS_ATTACHMENTS_MEMORY_RESERVATION=128m
# MAILU_FTS_ATTACHMENTS_CPU_RESERVATION=0.25
# MAILU_ANTISPAM_MEMORY_LIMIT=512m
# MAILU_ANTISPAM_CPU_LIMIT=1.0
# MAILU_ANTISPAM_MEMORY_RESERVATION=64m
# MAILU_ANTISPAM_CPU_RESERVATION=0.25
# MAILU_ANTIVIRUS_MEMORY_LIMIT=2g
# MAILU_ANTIVIRUS_CPU_LIMIT=2.0
# MAILU_ANTIVIRUS_MEMORY_RESERVATION=256m
# MAILU_ANTIVIRUS_CPU_RESERVATION=0.5
# MAILU_WEBDAV_MEMORY_LIMIT=512m
# MAILU_WEBDAV_CPU_LIMIT=1.0
# MAILU_WEBDAV_MEMORY_RESERVATION=64m
# MAILU_WEBDAV_CPU_RESERVATION=0.25
# MAILU_FETCHMAIL_MEMORY_LIMIT=512m
# MAILU_FETCHMAIL_CPU_LIMIT=1.0
# MAILU_FETCHMAIL_MEMORY_RESERVATION=64m
# MAILU_FETCHMAIL_CPU_RESERVATION=0.25
# MAILU_WEBMAIL_MEMORY_LIMIT=512m
# MAILU_WEBMAIL_CPU_LIMIT=1.0
# MAILU_WEBMAIL_MEMORY_RESERVATION=64m
# MAILU_WEBMAIL_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1

# How long docker waits for a data-owning service to shut down before it
# sends SIGKILL. The default of ten seconds can cut short a PostgreSQL
# checkpoint, an InnoDB flush or a Redis save; sixty is the value this
# repository ships. Raise it if your dataset is large.
# MAILU_REDIS_STOP_GRACE_PERIOD=60s

# Backup Variables (defaults shown). The backups service copies each SQLite
# database consistently (Python's sqlite3 backup API, no application stop) and
# archives the rest of the data directory on a loop; files land in the
# mailu-backups volume.
# MAILU_BACKUP_INIT_SLEEP=30m
# MAILU_BACKUP_INTERVAL=24h
# MAILU_BACKUP_PRUNE_DAYS=7
# MAILU_BACKUPS_PATH=/srv/mailu/backups
# MAILU_BACKUP_NAME=mailu-database-backup
# MAILU_DATA_BACKUP_NAME=mailu-data-backup

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# REDIS_IMAGE_VERSION=7.4
# RESOLVER_IMAGE_VERSION=2024.06.58
# FRONT_IMAGE_VERSION=2024.06.58
# ADMIN_IMAGE_VERSION=2024.06.58
# IMAP_IMAGE_VERSION=2024.06.58
# SMTP_IMAGE_VERSION=2024.06.58
# OLETOOLS_IMAGE_VERSION=2024.06.58
# FTS_ATTACHMENTS_IMAGE_VERSION=latest-full
# ANTISPAM_IMAGE_VERSION=2024.06.58
# ANTIVIRUS_IMAGE_VERSION=1.4
# WEBDAV_IMAGE_VERSION=2024.06.58
# FETCHMAIL_IMAGE_VERSION=2024.06.58
# WEBMAIL_IMAGE_VERSION=2024.06.58
