# Mailu + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# NOTE: this single file plays two roles. Docker Compose interpolates the
# UPPER-CASE variables below into the compose file (hostnames, image-tag
# overrides), and every Mailu container also loads this file via
# `env_file:` — so the Mailu application config (SECRET_KEY, DOMAIN,
# HOSTNAMES, ...) lives here too. The stack will not start without it.
#
# Image versions are NOT set here. The tested tag + sha256 digest for all
# fourteen images lives in the compose file's `x-images` block, so
# `git pull` delivers the combination this repository has tested. To pin
# differently, uncomment the matching *_IMAGE_TAG variable, e.g.:
# FRONT_IMAGE_TAG=ghcr.io/mailu/nginx:2024.06.58@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.mailu.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Hostnames routed by Traefik (each needs a DNS record). REQUIRED.
# ──────────────────────────────────────────────────────────────────────────────

MAILU_HOSTNAME=mail.example.com
MAILU_ADMIN_HOSTNAME=admin.mailu.example.com
MAILU_WEBDAV_HOSTNAME=dav.mailu.example.com

# ──────────────────────────────────────────────────────────────────────────────
# Mailu core configuration (read by the containers via env_file)
# Full reference: https://mailu.io/2024.06/configuration.html
# ──────────────────────────────────────────────────────────────────────────────

# Cryptographic secret. REQUIRED — generate with:
#     openssl rand -hex 16
SECRET_KEY=change_me_before_first_start

# Primary mail domain (the part after @ in user addresses). REQUIRED.
DOMAIN=example.com

# Space-separated list of hostnames this server answers as; the first one
# is the canonical name and should match MAILU_HOSTNAME. REQUIRED.
HOSTNAMES=mail.example.com

# Postmaster local part (postmaster@DOMAIN receives abuse/postmaster mail).
POSTMASTER=admin

# TLS for the MAIL ports (SMTPS 465, IMAPS 993, POP3S 995). Traefik only
# terminates TLS for the WEB hostnames; the mail ports are passed through
# as raw TCP, so the `front` container needs its own certificates:
#   mail  — serve TLS from certs in the mailu-certificates volume
#           (export them from Traefik with a certs-dumper, or mount your
#           own cert.pem/key.pem there)
#   notls — plaintext mail ports; acceptable only for testing
TLS_FLAVOR=mail

# Initial admin account, created on first start (mode `update` keeps the
# password in sync with this file; use `ifmissing` to manage it in the UI
# after the first boot).
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=example.com
# REQUIRED — generate with: openssl rand -base64 24 | tr -d '/+=' | head -c 32
INITIAL_ADMIN_PW=change_me_before_first_start
INITIAL_ADMIN_MODE=update

# Web paths served under MAILU_HOSTNAME.
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEBROOT_REDIRECT=/webmail

# Feature toggles matching the services in the compose file.
ADMIN=true
WEBMAIL=roundcube
WEBDAV=radicale
ANTIVIRUS=clamav
SCAN_MACROS=true
FETCHMAIL_ENABLED=true

# Message size limit in bytes (default 50 MB).
MESSAGE_SIZE_LIMIT=50000000

# Internal addressing — must match the compose network settings below.
SUBNET=192.168.203.0/24
REDIS_ADDRESS=redis

# ──────────────────────────────────────────────────────────────────────────────
# Compose-side network settings (defaults in the compose file; keep the
# resolver inside SUBNET if you override)
# ──────────────────────────────────────────────────────────────────────────────

# RESOLVER_IP=192.168.203.254

# ──────────────────────────────────────────────────────────────────────────────
# More options (defaults shown; uncomment to change)
# ──────────────────────────────────────────────────────────────────────────────

# SITENAME=Mailu
# WEBSITE=https://mail.example.com
# TZ=UTC
# LOG_LEVEL=INFO
# API=false
# WEB_API=/api
# API_TOKEN=
# MESSAGE_RATELIMIT=200/day
# AUTH_RATELIMIT_IP=5/hour
# AUTH_RATELIMIT_USER=50/day
# PASSWORD_SCHEME=SHA512-CRYPT
# CREDENTIAL_ROUNDS=12
# RECIPIENT_DELIMITER=+
# DKIM_SELECTOR=mail
# DKIM_KEY_LENGTH=2048
# DMARC_RUA=admin
# DMARC_RUF=admin
# FETCHMAIL_DELAY=600
# FULL_TEXT_SEARCH_ATTACHMENTS=true
# DEFAULT_SPAM_THRESHOLD=80
# WELCOME=false
# RELAYHOST=
# RELAYNETS=
# DISABLE_STATISTICS=True
